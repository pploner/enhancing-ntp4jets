# Shared body for additive canonical-data submit files. This file has no queue
# statement and is included by the *_canonical.sub files.

executable = scripts/condor_run_training.sh

PROJECT_DIR = /eos/user/y/yelberke/enhancing-ntp4jets
OUTPUT_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CONDA_ENV = /eos/home-y/yelberke/conda_condor_orbit_env
ORBIT_MANIFEST_DIR = /eos/home-y/yelberke/enhancing-ntp4jets/manifests/production_final
GABBRO_ENV_FILE = /eos/home-y/yelberke/wandb.env
WANDB_MODE = online
NUM_WORKERS = 4
SUITE_ID = $(SUITE_BASE)_$(CANONICAL_EXPERIMENT)_$(Cluster)

arguments = $(PROJECT_DIR) $(OUTPUT_DIR) train $(SUITE_ID) $(Process) \
  experiment=$(CANONICAL_EXPERIMENT) \
  logger=wandb.yaml \
  task_name=orbit_particle_$(CANONICAL_EXPERIMENT)_$(RUN_NAME) \
  logger.wandb.name=orbit_particle_$(CANONICAL_EXPERIMENT)_$(RUN_NAME)_$(Cluster)_$(Process) \
  logger.wandb.group=$(SUITE_ID) \
  logger.wandb.project=orbit-tokenizer \
  $(MODEL_ARGS) \
  test=true \
  data.num_workers=$(NUM_WORKERS)

environment = "ORBIT_MANIFEST_DIR=$(ORBIT_MANIFEST_DIR) GABBRO_ENV_FILE=$(GABBRO_ENV_FILE) CONDA_ENV=$(CONDA_ENV) WANDB_MODE=$(WANDB_MODE) $(EXTRA_ENV:)"

log    = $(OUTPUT_DIR)/condor_logs/$(SUITE_BASE)_$(CANONICAL_EXPERIMENT)_$(Cluster).log
output = $(OUTPUT_DIR)/condor_logs/$(SUITE_BASE)_$(CANONICAL_EXPERIMENT)_$(RUN_NAME)_$(Cluster)_$(Process).out
error  = $(OUTPUT_DIR)/condor_logs/$(SUITE_BASE)_$(CANONICAL_EXPERIMENT)_$(RUN_NAME)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus = 4
request_memory = 16GB
request_gpus = 1
+JobFlavour = "tomorrow"
