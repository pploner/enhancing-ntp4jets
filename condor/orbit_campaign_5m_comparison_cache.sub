executable = scripts/condor_run_orbit_5m_plot_cache.sh

PROJECT_DIR = /eos/home-y/yelberke/enhancing-ntp4jets
RUN_ROOT = /eos/user/y/yelberke/enhancing_ntp4jets_runs
CACHE_DIR = $(RUN_ROOT)/writeup_cache/campaign_5m_comparison
MANIFEST_DIR = $(PROJECT_DIR)/manifests/production_final
LOG_DIR = $(RUN_ROOT)/condor_logs

arguments = $(SELECTION) $(SUITE) $(PROJECT_DIR) $(CACHE_DIR) $(MANIFEST_DIR)
environment = "CONDA_ENV=/eos/home-y/yelberke/conda_condor_orbit_env"

log = $(LOG_DIR)/orbit_campaign_5m_comparison_$(Cluster).log
output = $(LOG_DIR)/orbit_campaign_5m_comparison_$(SELECTION)_$(SUITE)_$(Cluster)_$(Process).out
error = $(LOG_DIR)/orbit_campaign_5m_comparison_$(SELECTION)_$(SUITE)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus = 2
request_memory = 8GB
request_gpus = 1
+JobFlavour = "$(JOB_FLAVOUR)"

queue 1
