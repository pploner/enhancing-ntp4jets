executable = scripts/condor_run_orbit_downstream_cache.sh

PROJECT_DIR = /eos/home-y/yelberke/enhancing-ntp4jets
RUN_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs/plotting_runs/full500-sm-vq4096
CACHE_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs/writeup_cache/full500_sm_vq4096
MANIFEST_DIR = /eos/home-y/yelberke/enhancing-ntp4jets/manifests/production_final
LOG_DIR = /eos/user/y/yelberke/enhancing_ntp4jets_runs/condor_logs

arguments = $(MODE) $(PROJECT_DIR) $(RUN_DIR) $(CACHE_DIR) $(MANIFEST_DIR)
environment = "CONDA_ENV=/eos/home-y/yelberke/conda_condor_orbit_env"

log = $(LOG_DIR)/orbit_campaign_5m_vq4096_downstream_$(Cluster).log
output = $(LOG_DIR)/orbit_campaign_5m_vq4096_downstream_$(MODE)_$(Cluster)_$(Process).out
error = $(LOG_DIR)/orbit_campaign_5m_vq4096_downstream_$(MODE)_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus = 4
request_memory = 16GB
request_gpus = 1
+JobFlavour = "$(JOB_FLAVOUR)"

queue 1
